# Copy to .env (never commit it). In Claude cloud sessions, API keys are injected
# by the network proxy instead, so these can stay as placeholders there.

# Lead sources
HUNTER_API_KEY=placeholder          # https://hunter.io  -> finds emails for a company domain
GOOGLE_PLACES_API_KEY=placeholder   # Google Cloud "Places API (New)" -> finds companies + websites

# Sending (only used by `send --via smtp`, typically on your own computer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourfirm.com
SMTP_PASSWORD=app-password

# Safety limits
OUTREACH_DAILY_LIMIT=30
